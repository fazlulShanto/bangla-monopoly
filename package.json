{
  "name": "deshi-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "setup": "bun run scripts/setup-env.ts",
    "dev": "concurrently -k -n server,web -c cyan,green \"bun run --cwd apps/server dev\" \"bun run --cwd apps/web dev\"",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:realtime": "bun run scripts/realtime-smoke.ts",
    "start": "bun run apps/server/src/index.ts"
  },
  "dependencies": {
    "@deshi/game": "workspace:*",
    "@fontsource/dm-sans": "latest",
    "@fontsource/space-grotesk": "latest",
    "ioredis": "^6.0.0",
    "lucide-react": "latest",
    "mongodb": "^7.8.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
