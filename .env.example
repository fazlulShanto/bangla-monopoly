# Server only. Never prefix the MongoDB URI with VITE_.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=deshi_tycoon
REDIS_URI=redis://127.0.0.1:6379
# Generate these with bun run setup. Keep the secret private.
SOKETI_APP_ID=deshi-tycoon
# SOKETI_APP_KEY is generated by bun run setup.
# SOKETI_APP_SECRET is generated by bun run setup.
SOKETI_HOST=127.0.0.1
SOKETI_PORT=6001
PORT=3001
APP_PORT=8080
APP_BIND=127.0.0.1
# Set this to your VPS domain before enabling the https profile.
DOMAIN=game.example.com
REDIS_URI=redis://default:default@localhost:6391
